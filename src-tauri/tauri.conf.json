{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ESC POS Virtual Printer",
  "version": "1.0.0",
  "identifier": "com.haolun.escpos-virtual-printer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "DeveloperTool",
    "shortDescription": "ESC/POS virtual receipt printer on port 9100",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
